# Copy this file to server/.env and add a newly rotated Hugging Face token.
HF_TOKEN=hf_your_rotated_token_here

# Text-to-image model, used when no canvas image is selected.
HF_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Image-to-image model, used when a canvas image is selected.
# This model supports Chinese editing prompts and is available through fal-ai.
HF_IMAGE_MODEL=Qwen/Qwen-Image-Edit-2509
HF_IMAGE_PROVIDER=fal-ai
PORT=4300

# Use 0.0.0.0 when the production server runs inside a container or cloud host.
HOST=127.0.0.1

# Comma-separated frontend origins when the frontend and API use different domains.
CORS_ORIGIN=http://localhost:4200
